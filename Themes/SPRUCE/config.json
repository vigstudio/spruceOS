{
    "name": "Spruce",
    "author": "tenlevels",
    "description": "spruce theme for a30",
    "batteryPercentage": {
        "color": "#EBDBB2",
        "font": "nunwen.ttf",
        "size": 18
    },
    "title": {
        "font": "nunwen.ttf",
        "size": 25,
        "color": "#EBDBB2"
    },
    "hint": {
        "font": "nunwen.ttf",
        "size": 25,
        "color": "#EBDBB2"
    },
    "currentpage": {
        "font": "nunwen.ttf",
        "size": 22,
        "color": "#EBDBB2"
    },
    "total": {
        "font": "nunwen.ttf",
        "size": 22,
        "color": "#D65D0E"
    },
    "grid": {
        "font": "nunwen.ttf",
        "grid1x4": 25,
        "grid3x4": 18,
        "color": "#7C6F64",
        "selectedcolor": "#FBF1C7"
    },
    "list": {
        "font": "nunwen.ttf",
        "size": 24,
        "color": "#FBF1C7",
        "selectedcolor": "#FBF1C7"
    },
    "bindOverMiyooTheme": true,
    "recentsEnabled": false,
    "topBarInitialXOffset": 60,
    "setTopBarTextToGameSelection": true,
    "fullScreenGridGameMenuResizeType": "FIT",
    "mainMenuTitle": "",
    "displayVolumeNumbers": true,
    "screensaver": {
        "bgColor": "#1a0a2e",
        "bgImage": "",
        "overlayOpacity": 0.2,
        "overlayColor": "#000000",
        "blur": 2,
        "showClock": true,
        "showDate": true,
        "showBattery": true,
        "widgets": [
            {"type": "clock", "x": 0.5, "y": 0.15, "fontSize": 64, "color": "#00FFFF"},
            {"type": "date", "x": 0.5, "y": 0.30, "fontSize": 22, "color": "#CCCCCC"},
            {"type": "battery", "x": 0.85, "y": 0.85, "fontSize": 18, "color": "#88CC88"},
            {"type": "text", "x": 0.5, "y": 0.90, "fontSize": 14, "color": "#555555", "value": "spruceOS"}
        ]
    }
}